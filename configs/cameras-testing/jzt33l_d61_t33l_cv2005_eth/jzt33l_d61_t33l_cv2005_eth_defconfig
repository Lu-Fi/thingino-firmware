# NAME: JZT33L D61 test module (T33L, CV2005, ETH)
# FRAG: soc-xburst1 core
BR2_ETHERNET=y
# The T33 (PRJ008) MAC is the V13 one (vendor kernel config); the kopt default V12 does not build.
BR2_PACKAGE_THINGINO_KOPT_JZ_MAC_V13=y
BR2_INGENIC_SOC_MODEL="t33l"
# The open-stack streamer of the fleet (timps on OpenIMP libimp, T32/T33 builds since
# timps e56ae34). Sensor model / address / MCLK0 come from timps.conf in this directory:
# the open sinfo leaves /proc/jz/sensor empty (#513).
BR2_PACKAGE_THINGINO_STREAMER_TIMPS=y
# Sensor is a CV2005 (I2C0, 0x35); "none" because the SDK has no T33 sensor module or
# IQ bin. The vendor ko and PRJ008 bins come from a local overlay (README.md).
BR2_SENSOR_1_NAME="none"
# Vendor reserves 12704K at 0x3398000, but its main channel runs over IVDC (direct_mode=1,
# no frame buffers). Until direct mode works here (openimp #509) the buffered path needs
# 2 x 3 MiB main + sub stream + JPEG + a 3 MiB GetFrame copy (raw snapshot): 20 MiB (#516).
BR2_THINGINO_RMEM_MB=20
FLASH_SIZE_MB=16
KERNEL_VERSION_3=y
# Full thingino boot: the 2026.07 tree has the T33 SoC (isvp_t33_sfcnor = SOC_UBOOT,
# DDR2 650 MHz T33L profile, PY25Q128HA in the SPI NOR id table). The vendor kernel
# 3.10 SFC driver registers its MTD as sfc0_nor.
BR2_THINGINO_UBOOT_VERSION_2026_07=y
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_JZ_SFC=n
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_SFC0_NOR=y
# Audio: in-SoC codec (AMIC) on the kernel's jzsound oss3 audio.ko, loaded like the vendor
# (loadko.sh: insmod audio.ko spk_gpio=-1 fragment_time=4; no speaker amp GPIO), openimp #674.
BR2_THINGINO_AUDIO=y
BR2_THINGINO_AUDIO_PARAMS="fragment_time=4"
# Bench module: no boot / portal sounds (no audio playback without the user's OK).
BR2_PACKAGE_THINGINO_SOUNDS_STARTUP=n
BR2_PACKAGE_THINGINO_SOUNDS_CHIMES=n
