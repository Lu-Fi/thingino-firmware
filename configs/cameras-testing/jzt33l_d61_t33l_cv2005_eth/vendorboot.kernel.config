# The vendor U-Boot (2013.07-H20260203a, PRJ008) has no saved environment and
# always boots "sf0 read 0x80600000 0x250000 0x200000; bootm" with bootargs for the
# vendor partition table. The kernel therefore ignores the firmware command line
# and uses this one: vendor memory split (mem/rmem as the vendor bootargs), and a
# partition table that keeps U-Boot, factory and the vendor config area untouched
# and puts everything of thingino at or above 0x250000 (the vendor kernel offset).
#   mtd0 boot    0x000000  256k  vendor U-Boot (never written)
#   mtd1 env     0x450000   64k  thingino env (fw_env.config: /dev/mtd1 0x0 0x8000)
#   mtd2 kernel  0x250000 2048k  uImage (vendor U-Boot reads 2 MiB here)
#   mtd3 rootfs  0x460000 6080k  squashfs
#   mtd4 data    0xa50000 5824k  jffs2 overlay
#   mtd5 all     0x000000   16M
#   mtd6 factory 0x040000   64k  vendor licence block (read-only)
#   mtd7 config  0x050000 2048k  vendor config jffs2 (read-only, kept for rollback)
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS1,115200n8 mem=52832K@0x0 rmem=12704K@0x3398000 panic=10 root=/dev/mtdblock3 rootfstype=squashfs init=/init mtdparts=sfc0_nor:256k@0(boot),64k@0x450000(env),2048k@0x250000(kernel),6080k@0x460000(rootfs),5824k@0xa50000(data),16384k@0(all),64k@0x40000(factory)ro,2048k@0x50000(config)ro"
CONFIG_CMDLINE_OVERRIDE=y
