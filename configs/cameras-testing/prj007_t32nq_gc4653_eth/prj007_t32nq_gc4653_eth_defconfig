# NAME: PRJ007 test module (T32NQ, GC4653, ETH)
# FRAG: soc-xburst1 core
BR2_ETHERNET=y
BR2_INGENIC_SOC_MODEL="t32nq"
BR2_PACKAGE_THINGINO_KOPT_JZ_MAC_V13=y
BR2_PACKAGE_THINGINO_STREAMER_NONE=y
# Full thingino boot: U-Boot 2026.07 isvp_t32nq_sfcnor (TPL + SPL + U-Boot,
# PRJ007 vendor clocks and DDR3 timings, uboot patch 0006) and the standard
# 16 MiB layout. The vendor kernel 3.10 SFC driver registers its MTD as sfc0_nor.
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_JZ_SFC=n
BR2_PACKAGE_THINGINO_UBOOT_FLASH_CONTROLLER_SFC0_NOR=y
BR2_SENSOR_1_NAME="gc4653"
# Vendor bootargs: mem=73728K@0x0 rmem=57344K@0x4800000 (= 72M / 56M).
BR2_THINGINO_RMEM_MB=56
BR2_THINGINO_UBOOT_VERSION_2026_07=y
FLASH_SIZE_MB=16
KERNEL_VERSION_3=y
