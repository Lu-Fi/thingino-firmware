# NAME: O-KAM QC3 (T23DL, GC1084, AIC8800DC USB)
# FRAG: soc-xburst1 core
# PCB "QC6-V8-T23N-202404017-V1" (U-Boot banner), 32 MB T23DL, product
# QC3-W. Values from the OEM firmware (vp_project 2025-09, tx-isp-t23
# H20241028a): sensor gc1084 at i2c 0x37 (sinfo.ko sensor table), IQ =
# gc1084-okam_qc3.bin (byte-identical to the OEM gc1084-t23.bin), OEM
# tx-isp-t23 isp_memopt=1 direct_mode=1 isp_clk=200M isp_clka=600M
# ivdc_mem_line=300 with mem=25088K rmem=7680K.
# WiFi: AIC8800DC on USB, a69c:88dc (device lsusb after the WLAN power
# GPIO 62 is driven low). The OEM ships a D80 set in /addfs/wifi too, but
# the DC firmware in /addfs/wifi/aic8800DC is the one this chip uses.
# Open stack (open-tx-isp + OpenIMP + timps) with the OEM IVDC direct mode
# (OpenIMP #767). rmem is whole MB here: 8M (OEM 7.5M) - 7M would be below
# the OEM pool, 8M is the split the A12 T23DL runs in QEMU (H.264 main via
# IVDC + sub + JPEG), Linux keeps 24M (512K less than OEM).
BR2_INGENIC_SOC_MODEL="t23dl"
BR2_ISP_CLKA_600MHZ=y
BR2_ISP_CLKA_SCLKA=y
BR2_ISP_CLK_200MHZ=y
BR2_ISP_CLK_SCLKA=y
BR2_ISP_DIRECT_MODE_1=y
BR2_ISP_MEMOPT_1=y
BR2_ISP_PARAMS="ivdc_mem_line=300"
BR2_PACKAGE_THINGINO_ISP_OPEN=y
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_THINGINO_STREAMER_TIMPS=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_AIC8800=y
BR2_PACKAGE_WIFI_AIC8800_USB=y
BR2_PACKAGE_WIFI_AIC8800_USB_8800DC=y
BR2_SENSOR_1_IQ_FILE="gc1084-okam_qc3.bin"
BR2_SENSOR_1_NAME="gc1084"
BR2_THINGINO_AUDIO=y
BR2_THINGINO_AUDIO_GPIO=63
BR2_THINGINO_BUTTON=y
BR2_THINGINO_RMEM_MB=8
BR2_THINGINO_SDCARD=y
FLASH_SIZE_MB=8
KERNEL_VERSION_3=y
# Reset diagnostics (#800): reset cause + last panic epc in RTC + reset PC sled (no RAM reserved).
BR2_THINGINO_DIAG_RESETCAUSE=y
BR2_THINGINO_DIAG_LASTPANIC=y
BR2_THINGINO_DIAG_RESET_SLED=y
