diff -urN a/arch/mips/xburst/common/diag_lastpanic.c b/arch/mips/xburst/common/diag_lastpanic.c
--- a/arch/mips/xburst/common/diag_lastpanic.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/mips/xburst/common/diag_lastpanic.c	2026-10-31 13:44:28.953855723 +0100
@@ -0,0 +1,443 @@
+/*
+ * Reset-surviving record of the last kernel death (diagnostics only,
+ * CONFIG_JZ_DIAG_LASTPANIC).
+ *
+ * DRAM does not survive the WDT reset on these SoCs, so pstore/ramoops cannot
+ * work. This keeps a few words in places that a WDT reset does not clear:
+ *
+ *   CPM CPSPR  0x10000034  0xD2 magic | flags | reason | uptime minutes
+ *                          (documented "not initialized by power on and WDT
+ *                          reset"; low 16 bits never 0x1a1a/0x0666, bits 22:18
+ *                          never set - those are boot signatures)
+ *   RTC RTCSAR 0x10003008  oops: sp; panic: comm; restart: pid | ppid << 16
+ *                          (RTC domain, WDT reset does not change it; written
+ *                          only while the RTC alarm is disabled, RTCCR.AE = 0)
+ *   CP0 EPC     $14        oops: epc; panic: message[0..3]; restart: comm[0..3]
+ *   CP0 EntryLo0 $2        oops: ra (word offset, 64 MB kseg0/kseg2 window);
+ *                          panic: message[4..6]; restart: comm[4..6]
+ *   CP0 EntryLo1 $3        oops: sp (64 MB kseg0 window); panic: comm[0..2];
+ *                          restart: pid
+ *   CP0 EntryHi $10        uptime seconds (19 bit) << 13 | xor8 checksum
+ *
+ * The CP0 words rely on the core keeping its state over the WDT reset, the
+ * same thing the boot-time "CPU0 RESET ERROR PC" print relies on. U-Boot SPL
+ * and U-Boot do not write these four CP0 registers; the kernel writes them
+ * only after cpu_probe(), where they are captured. The CP0 words are written
+ * last, from jz_wdt_restart(), because any TLB exception after the panic
+ * notifier would overwrite EPC.
+ *
+ * /proc/diag_lastpanic: read = decoded record of the previous boot,
+ * write "oops" (NULL dereference), "panic", "selftest" (store a known pattern,
+ * no reset; follow with reboot -f).
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/notifier.h>
+#include <linux/kdebug.h>
+#include <linux/reboot.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/sched.h>
+#include <linux/jiffies.h>
+#include <linux/hardirq.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/irqflags.h>
+#include <asm/mipsregs.h>
+#include <asm/ptrace.h>
+
+#define DREG(a)		(*(volatile u32 *)(0xa0000000 | (a)))
+#define D_CPSPR		0x10000034
+#define D_CPSPPR	0x10000038
+#define D_RSR		0x10000008
+#define D_RTCCR		0x10003000
+#define D_RTCSAR	0x10003008
+#define D_WENR		0x1000303c
+
+#define RTCCR_WRDY	(1 << 7)
+#define RTCCR_AE	(1 << 2)
+#define WENR_WEN	(1u << 31)
+
+#define CPS_MAGIC	0xd2000000u
+#define CPS_RTC		(1u << 23)	/* RTCSAR holds this record */
+#define CPS_RESTART	(1u << 16)	/* jz_wdt_restart() was reached */
+#define CPS_ONE		(1u << 15)	/* keeps the low half off boot signatures */
+#define ELO_MARK	(1u << 25)
+
+enum {
+	R_SELFTEST = 0, R_OOPS, R_PANIC, R_HUNG, R_LOCKUP, R_REBOOT,
+	R_RESTART, R_OOPS_IRQ,
+};
+static const char *const reason_name[8] = {
+	"selftest", "oops", "panic", "hung_task", "lockup", "reboot",
+	"restart", "oops_in_irq",
+};
+
+struct diag_rec {
+	int valid;
+	u32 reason, up_s;
+	u32 epc, elo0, elo1, rtc;	/* words as stored */
+	u32 cps;
+};
+static struct diag_rec rec;
+
+static struct {
+	int done;
+	u32 errorepc, epc, elo0, elo1, entryhi, cpspr, rtcsar, rtccr, rsr;
+} boot;
+
+static u32 xor8(u32 v)
+{
+	return (v ^ (v >> 8) ^ (v >> 16) ^ (v >> 24)) & 0xff;
+}
+
+static u32 csum(u32 cps, u32 epc, u32 elo0, u32 elo1, u32 rtc)
+{
+	return xor8((cps & ~CPS_RESTART) ^ epc ^ (elo0 & 0x3ffffff) ^
+		    (elo1 & 0x3ffffff) ^ rtc) ^ 0x5a;
+}
+
+static u32 enc_addr(u32 a)	/* 24-bit word offset + kseg2 flag */
+{
+	u32 v = (a & 0x03fffffc) >> 2;
+
+	if ((a & 0xe0000000) == 0xc0000000)
+		v |= 1 << 24;
+	return v | ELO_MARK;
+}
+
+static u32 dec_addr(u32 v)
+{
+	return ((v & (1 << 24)) ? 0xc0000000 : 0x80000000) | ((v & 0xffffff) << 2);
+}
+
+static u32 enc_sp(u32 sp)
+{
+	return ((sp & 0x03fffff8) >> 3) | ELO_MARK;
+}
+
+static u32 dec_sp(u32 v)
+{
+	return 0x80000000 | ((v & 0x7fffff) << 3);
+}
+
+static u32 pack4(const char *s)
+{
+	u32 v = 0;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		v <<= 8;
+		if (*s)
+			v |= (u8)*s++;
+	}
+	return v;
+}
+
+static u32 pack3(const char *s)
+{
+	return (pack4(s) >> 8) | ELO_MARK;
+}
+
+static u32 uptime_s(void)
+{
+	return (u32)((jiffies - INITIAL_JIFFIES) / HZ);
+}
+
+static int rtc_ready(void)
+{
+	int i;
+
+	for (i = 0; i < 200000; i++)
+		if (DREG(D_RTCCR) & RTCCR_WRDY)
+			return 1;
+	return 0;
+}
+
+static int rtc_write(u32 reg, u32 val)
+{
+	int i;
+
+	if (!rtc_ready())
+		return -1;
+	DREG(D_WENR) = 0xa55a;
+	for (i = 0; i < 200000; i++)
+		if (DREG(D_WENR) & WENR_WEN)
+			break;
+	if (!(DREG(D_WENR) & WENR_WEN) || !rtc_ready())
+		return -1;
+	DREG(reg) = val;
+	if (!rtc_ready())
+		return -1;
+	return DREG(reg) == val ? 0 : -1;
+}
+
+static void cpspr_write(u32 val)
+{
+	int t;
+	volatile int i;
+
+	for (t = 0; t < 3; t++) {
+		DREG(D_CPSPPR) = 0x5a5a;
+		for (i = 0; i < 0x3ff; i++)
+			;
+		DREG(D_CPSPR) = val;
+		DREG(D_CPSPPR) = 0xa5a5;
+		if (DREG(D_CPSPR) == val)
+			break;
+	}
+}
+
+/* CPM/RTC words: safe to write at any time, written as soon as a record exists */
+static void store_mmio(void)
+{
+	u32 up_min = rec.up_s / 60;
+
+	if (up_min > 0xfff)
+		up_min = 0xfff;
+	rec.cps = CPS_MAGIC | CPS_ONE | ((rec.reason & 7) << 12) | up_min |
+		  (rec.cps & CPS_RESTART);
+	if (!(DREG(D_RTCCR) & RTCCR_AE) && rtc_write(D_RTCSAR, rec.rtc) == 0)
+		rec.cps |= CPS_RTC;
+	cpspr_write(rec.cps);
+}
+
+/* CP0 words: rewritten at the very end (EPC changes on every exception) */
+static void store_cp0(void)
+{
+	u32 cs = csum(rec.cps, rec.epc, rec.elo0, rec.elo1,
+		      (rec.cps & CPS_RTC) ? rec.rtc : 0);
+
+	write_c0_epc(rec.epc);
+	write_c0_entrylo0(rec.elo0);
+	write_c0_entrylo1(rec.elo1);
+	write_c0_entryhi(((rec.up_s & 0x7ffff) << 13) | cs);
+}
+
+static void fill_comm(u32 reason)
+{
+	struct task_struct *p = current;
+	u32 pid = task_pid_nr(p), ppid = 0;
+
+	rcu_read_lock();
+	if (p->real_parent)
+		ppid = task_pid_nr(p->real_parent);
+	rcu_read_unlock();
+	rec.reason = reason;
+	rec.up_s = uptime_s();
+	rec.epc = pack4(p->comm);
+	rec.elo0 = strlen(p->comm) > 4 ? pack3(p->comm + 4) : ELO_MARK;
+	rec.elo1 = (pid & 0x7fffff) | ELO_MARK;
+	rec.rtc = (pid & 0xffff) | (ppid << 16);
+	rec.valid = 1;
+}
+
+/* called from jz_wdt_restart() right before the WDT is armed */
+void diag_lastpanic_commit(void)
+{
+	/* no exception may follow the CP0 writes (EPC); the WDT resets in 4 ms */
+	local_irq_disable();
+	if (!rec.valid)
+		fill_comm(R_RESTART);
+	rec.cps |= CPS_RESTART;
+	store_mmio();
+	store_cp0();
+}
+
+static int diag_die(struct notifier_block *nb, unsigned long val, void *data)
+{
+	struct die_args *args = data;
+	struct pt_regs *regs = args ? args->regs : NULL;
+
+	if (val != DIE_OOPS || !regs || (rec.valid && rec.reason != R_REBOOT))
+		return NOTIFY_DONE;
+	rec.reason = in_interrupt() ? R_OOPS_IRQ : R_OOPS;
+	rec.up_s = uptime_s();
+	rec.epc = regs->cp0_epc;
+	rec.elo0 = enc_addr(regs->regs[31]);
+	rec.elo1 = enc_sp(regs->regs[29]);
+	rec.rtc = regs->regs[29];
+	rec.valid = 1;
+	/* CP0 only from panic/restart: die() may still sleep with IRQs on */
+	store_mmio();
+	return NOTIFY_DONE;
+}
+
+static int diag_panic(struct notifier_block *nb, unsigned long ev, void *buf)
+{
+	const char *msg = buf ? buf : "";
+
+	if (!rec.valid || rec.reason == R_REBOOT || rec.reason == R_RESTART) {
+		u32 r = R_PANIC;
+
+		if (strstr(msg, "hung_task"))
+			r = R_HUNG;
+		else if (strstr(msg, "lockup") || strstr(msg, "LOCKUP"))
+			r = R_LOCKUP;
+		fill_comm(r);
+		rec.rtc = pack4(current->comm);
+		rec.elo1 = pack3(current->comm);
+		rec.epc = pack4(msg);
+		rec.elo0 = strlen(msg) > 4 ? pack3(msg + 4) : ELO_MARK;
+	}
+	store_mmio();
+	store_cp0();
+	return NOTIFY_DONE;
+}
+
+static int diag_reboot(struct notifier_block *nb, unsigned long ev, void *cmd)
+{
+	if (!rec.valid) {
+		fill_comm(R_REBOOT);
+		store_mmio();
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block diag_die_nb = { .notifier_call = diag_die, .priority = INT_MAX };
+static struct notifier_block diag_panic_nb = { .notifier_call = diag_panic, .priority = INT_MAX };
+static struct notifier_block diag_reboot_nb = { .notifier_call = diag_reboot, .priority = INT_MAX };
+
+/* called once from cpu_probe_ingenic(), before trap/TLB init touches CP0 */
+void diag_lastpanic_capture(unsigned int errorepc)
+{
+	if (boot.done)
+		return;
+	boot.done = 1;
+	boot.errorepc = errorepc;
+	boot.epc = read_c0_epc();
+	boot.elo0 = read_c0_entrylo0();
+	boot.elo1 = read_c0_entrylo1();
+	boot.entryhi = read_c0_entryhi();
+	boot.cpspr = DREG(D_CPSPR);
+	boot.rtcsar = DREG(D_RTCSAR);
+	boot.rtccr = DREG(D_RTCCR);
+	boot.rsr = DREG(D_RSR);
+}
+
+/* append n bytes of w (big-endian packed text) to s as printable chars */
+static void get_chars(char *s, u32 w, int n)
+{
+	int i;
+
+	s += strlen(s);
+	for (i = 0; i < n; i++) {
+		u8 c = (w >> (8 * (n - 1 - i))) & 0xff;
+
+		if (!c)
+			break;
+		*s++ = (c >= 0x20 && c < 0x7f && c != '"') ? c : '.';
+	}
+	*s = '\0';
+}
+
+static int diag_show(struct seq_file *m, void *v)
+{
+	u32 cps = boot.cpspr;
+	int cps_ok = (cps & 0xff008000) == (CPS_MAGIC | CPS_ONE) && !(cps & 0x7c0000);
+	u32 rtcw = (cps_ok && (cps & CPS_RTC)) ? boot.rtcsar : 0;
+	int cp0_ok = (boot.elo0 & ELO_MARK) && (boot.elo1 & ELO_MARK) &&
+		     csum(cps, boot.epc, boot.elo0, boot.elo1, rtcw) == (boot.entryhi & 0xff);
+	u32 reason = (cps >> 12) & 7;
+
+	seq_printf(m, "raw cpspr=0x%08x rtcsar=0x%08x rtccr=0x%08x rsr=0x%08x errorepc=0x%08x c0_epc=0x%08x c0_entrylo0=0x%08x c0_entrylo1=0x%08x c0_entryhi=0x%08x\n",
+		   boot.cpspr, boot.rtcsar, boot.rtccr, boot.rsr, boot.errorepc,
+		   boot.epc, boot.elo0, boot.elo1, boot.entryhi);
+	seq_printf(m, "errorepc %pS\n", (void *)boot.errorepc);
+	if (!cps_ok && !cp0_ok) {
+		seq_printf(m, "record none\n");
+		return 0;
+	}
+	seq_printf(m, "record cpspr_ok=%d cp0_ok=%d rtcsar_used=%d reason=%s reached_restart=%d uptime_min=%u%s uptime_s_mod=%u\n",
+		   cps_ok, cp0_ok, !!(cps_ok && (cps & CPS_RTC)),
+		   cps_ok ? reason_name[reason] : "unknown",
+		   cps_ok ? !!(cps & CPS_RESTART) : -1,
+		   cps & 0xfff, (cps & 0xfff) == 0xfff ? "+" : "",
+		   boot.entryhi >> 13);
+	if (!cps_ok || reason == R_OOPS || reason == R_OOPS_IRQ || reason == R_SELFTEST) {
+		u32 ra = dec_addr(boot.elo0), sp = rtcw ? rtcw : dec_sp(boot.elo1);
+
+		seq_printf(m, "epc=0x%08x ra=0x%08x sp=0x%08x\n", boot.epc, ra, sp);
+		seq_printf(m, "epc %pS\nra %pS\n", (void *)boot.epc, (void *)ra);
+	} else if (reason == R_REBOOT || reason == R_RESTART) {
+		char c[8] = "";
+
+		get_chars(c, boot.epc, 4);
+		get_chars(c, boot.elo0 & 0xffffff, 3);
+		seq_printf(m, "comm=\"%s\" pid=%u ppid=%u\n", c,
+			   rtcw ? rtcw & 0xffff : boot.elo1 & 0x7fffff, rtcw >> 16);
+	} else {
+		char t[8] = "", c[8] = "";
+
+		get_chars(t, boot.epc, 4);
+		get_chars(t, boot.elo0 & 0xffffff, 3);
+		if (rtcw)
+			get_chars(c, rtcw, 4);
+		else
+			get_chars(c, boot.elo1 & 0xffffff, 3);
+		seq_printf(m, "msg=\"%s\" comm=\"%s\"\n", t, c);
+	}
+	return 0;
+}
+
+static int diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, diag_show, NULL);
+}
+
+static int *volatile diag_null;
+
+static ssize_t diag_write(struct file *file, const char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	char b[16] = { 0 };
+
+	if (copy_from_user(b, ubuf, min(count, sizeof(b) - 1)))
+		return -EFAULT;
+	if (!strncmp(b, "oops", 4)) {
+		pr_emerg("diag_lastpanic: test oops (NULL dereference) requested\n");
+		*diag_null = 0xd1a9;
+	} else if (!strncmp(b, "panic", 5)) {
+		panic("diag_lastpanic test panic");
+	} else if (!strncmp(b, "selftest", 8)) {
+		rec.reason = R_SELFTEST;
+		rec.up_s = uptime_s();
+		rec.epc = 0xd1a9e9c0;
+		rec.elo0 = enc_addr(0x8012345c);
+		rec.elo1 = enc_sp(0x8123abc8);
+		rec.rtc = 0x8123abc8;
+		rec.valid = 1;
+		store_mmio();	/* CP0 follows in jz_wdt_restart() */
+		pr_info("diag_lastpanic: selftest stored cpspr=0x%08x (readback 0x%08x) rtcsar readback 0x%08x; now reboot -f\n",
+			rec.cps, DREG(D_CPSPR), DREG(D_RTCSAR));
+	} else {
+		return -EINVAL;
+	}
+	return count;
+}
+
+static const struct file_operations diag_fops = {
+	.open = diag_open,
+	.read = seq_read,
+	.write = diag_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int __init diag_lastpanic_init(void)
+{
+	/* consume the previous record so a later plain reset is not misread */
+	if ((boot.cpspr & 0xff008000) == (CPS_MAGIC | CPS_ONE)) {
+		cpspr_write(0);
+		if ((boot.cpspr & CPS_RTC) && !(DREG(D_RTCCR) & RTCCR_AE))
+			rtc_write(D_RTCSAR, 0);
+	}
+	register_die_notifier(&diag_die_nb);
+	atomic_notifier_chain_register(&panic_notifier_list, &diag_panic_nb);
+	register_reboot_notifier(&diag_reboot_nb);
+	proc_create("diag_lastpanic", 0600, NULL, &diag_fops);
+	pr_info("diag_lastpanic: prev cpspr=0x%08x c0_epc=0x%08x entrylo0=0x%08x entrylo1=0x%08x entryhi=0x%08x rtcsar=0x%08x\n",
+		boot.cpspr, boot.epc, boot.elo0, boot.elo1, boot.entryhi, boot.rtcsar);
+	return 0;
+}
+core_initcall(diag_lastpanic_init);
