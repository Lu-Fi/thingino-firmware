diff -urN a/arch/mips/xburst/common/diag_lastpanic.c b/arch/mips/xburst/common/diag_lastpanic.c
--- a/arch/mips/xburst/common/diag_lastpanic.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/mips/xburst/common/diag_lastpanic.c	2026-10-31 14:02:53.208857233 +0100
@@ -0,0 +1,504 @@
+/*
+ * Reset-surviving record of the last kernel death (diagnostics only,
+ * CONFIG_JZ_DIAG_LASTPANIC, T23/T31).
+ *
+ * DRAM and CPM CPSPR do not survive the WDT reset (measured on T31L);
+ * RTC RTCSAR (0x10003008, RTC domain) does (measured on T31L). The alarm is
+ * unused (no RTC_CLASS), RTCSAR is written only while RTCCR.AE = 0.
+ *
+ * Primary channel, RTCSAR (one 32-bit word, 0 = no record):
+ *   [31:28] reason (1..8)
+ *   [27]    jz_wdt_restart() was reached (clean restart after the record)
+ *   [26:24] uptime bucket: <1m <10m <1h <6h <24h <3d <7d >=7d
+ *   [23:0]  oops: [23] kseg2 (module) flag, [22:0] epc word offset in the
+ *           32 MB window at 0x80000000 / 0xc0000000;
+ *           panic/reboot/restart: first 3 chars of current->comm
+ *
+ * Optional second channel, NOT proven (inferred from ErrorEPC surviving the
+ * reset): CP0 EPC = epc (full) or text, EntryLo0 = ra (24-bit word offset +
+ * kseg2 flag) or text, EntryLo1 = sp >> 3, EntryHi = uptime s << 13 | xor8
+ * checksum. Written only with IRQs off on the way to the reset (panic
+ * notifier, jz_wdt_restart()); captured in cpu_probe_ingenic().
+ *
+ * /proc/diag_lastpanic: read = decoded previous record; write "oops",
+ * "panic", "selftest" (store a known record, no reset; then reboot -f).
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/notifier.h>
+#include <linux/kdebug.h>
+#include <linux/reboot.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/sched.h>
+#include <linux/jiffies.h>
+#include <linux/hardirq.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/irqflags.h>
+#include <asm/mipsregs.h>
+#include <asm/ptrace.h>
+
+#define DREG(a)		(*(volatile u32 *)(0xa0000000 | (a)))
+#define D_RSR		0x10000008
+#define D_RTCCR		0x10003000
+#define D_RTCSAR	0x10003008
+#define D_WENR		0x1000303c
+
+#define RTCCR_WRDY	(1 << 7)
+#define RTCCR_AE	(1 << 2)
+#define WENR_WEN	(1u << 31)
+
+#define W_RESTART	(1u << 27)
+#define ELO_MARK	(1u << 25)
+
+enum {
+	R_NONE = 0, R_OOPS, R_PANIC, R_HUNG, R_LOCKUP, R_REBOOT, R_RESTART,
+	R_OOPS_IRQ, R_SELFTEST,
+};
+static const char *const reason_name[16] = {
+	"none", "oops", "panic", "hung_task", "lockup", "reboot", "restart",
+	"oops_in_irq", "selftest",
+};
+static const char *const up_name[8] = {
+	"<1m", "1m-10m", "10m-1h", "1h-6h", "6h-24h", "1d-3d", "3d-7d", ">=7d",
+};
+
+struct diag_rec {
+	int valid;
+	u32 reason, up_s;
+	u32 word;			/* RTCSAR */
+	u32 epc, elo0, elo1;		/* CP0 (optional channel) */
+};
+static struct diag_rec rec;
+
+static struct {
+	int done;
+	u32 errorepc, epc, elo0, elo1, entryhi, rtcsar, rtccr, rsr;
+	u32 rtcsar_early, rtccr_early, wrdy_early;	/* cpu_probe time */
+	u32 rtcsar_late, rtccr_late;			/* core_initcall time */
+	int clr_rc;
+	u32 clr_rb;
+} boot;
+
+/* status of the last RTC write attempt (shown in /proc, no console needed) */
+static struct {
+	u32 stage, rtccr0, rtccr1, wenr, rb, reg, val;
+	int rc;
+	u32 ok, fail, skip_ae, n;
+} lw;
+
+static u32 xor8(u32 v)
+{
+	return (v ^ (v >> 8) ^ (v >> 16) ^ (v >> 24)) & 0xff;
+}
+
+static u32 csum(u32 word, u32 epc, u32 elo0, u32 elo1)
+{
+	return xor8((word & ~W_RESTART) ^ epc ^ (elo0 & 0x3ffffff) ^
+		    (elo1 & 0x3ffffff)) ^ 0x5a;
+}
+
+static u32 up_bucket(u32 s)
+{
+	static const u32 lim[7] = { 60, 600, 3600, 21600, 86400, 259200, 604800 };
+	u32 i;
+
+	for (i = 0; i < 7; i++)
+		if (s < lim[i])
+			return i;
+	return 7;
+}
+
+static u32 enc_epc23(u32 a)	/* [23] kseg2, [22:0] word offset (32 MB) */
+{
+	u32 v = (a & 0x01fffffc) >> 2;
+
+	if ((a & 0xe0000000) == 0xc0000000)
+		v |= 1 << 23;
+	return v;
+}
+
+static u32 dec_epc23(u32 v)
+{
+	return ((v & (1 << 23)) ? 0xc0000000 : 0x80000000) | ((v & 0x7fffff) << 2);
+}
+
+static u32 enc_addr(u32 a)	/* CP0: 24-bit word offset + kseg2 flag */
+{
+	u32 v = (a & 0x03fffffc) >> 2;
+
+	if ((a & 0xe0000000) == 0xc0000000)
+		v |= 1 << 24;
+	return v | ELO_MARK;
+}
+
+static u32 dec_addr(u32 v)
+{
+	return ((v & (1 << 24)) ? 0xc0000000 : 0x80000000) | ((v & 0xffffff) << 2);
+}
+
+static u32 enc_sp(u32 sp)
+{
+	return ((sp & 0x03fffff8) >> 3) | ELO_MARK;
+}
+
+static u32 dec_sp(u32 v)
+{
+	return 0x80000000 | ((v & 0x7fffff) << 3);
+}
+
+static u32 pack4(const char *s)
+{
+	u32 v = 0;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		v <<= 8;
+		if (*s)
+			v |= (u8)*s++;
+	}
+	return v;
+}
+
+static u32 pack3(const char *s)
+{
+	return pack4(s) >> 8;
+}
+
+static u32 uptime_s(void)
+{
+	return (u32)((jiffies - INITIAL_JIFFIES) / HZ);
+}
+
+static int rtc_ready(void)
+{
+	int i;
+
+	for (i = 0; i < 200000; i++)
+		if (DREG(D_RTCCR) & RTCCR_WRDY)
+			return 1;
+	return 0;
+}
+
+static int rtc_write(u32 reg, u32 val)
+{
+	int i;
+
+	lw.n++;
+	lw.reg = reg;
+	lw.val = val;
+	lw.rtccr0 = DREG(D_RTCCR);
+	lw.stage = 1;
+	if (!rtc_ready())
+		goto fail;
+	DREG(D_WENR) = 0xa55a;
+	lw.stage = 2;
+	if (!rtc_ready())
+		goto fail;
+	for (i = 0; i < 200000; i++)
+		if (DREG(D_WENR) & WENR_WEN)
+			break;
+	lw.wenr = DREG(D_WENR);
+	if (!(lw.wenr & WENR_WEN))
+		goto fail;
+	lw.stage = 3;
+	if (!rtc_ready())
+		goto fail;
+	DREG(reg) = val;
+	lw.stage = 4;
+	if (!rtc_ready())
+		goto fail;
+	lw.stage = 5;
+	lw.rb = DREG(reg);
+	lw.rtccr1 = DREG(D_RTCCR);
+	if (lw.rb != val)
+		goto fail;
+	lw.stage = 0;
+	lw.rc = 0;
+	lw.ok++;
+	return 0;
+fail:
+	lw.rc = -1;
+	lw.fail++;
+	return -1;
+}
+
+static void make_word(u32 payload24)
+{
+	rec.word = ((rec.reason & 0xf) << 28) | (up_bucket(rec.up_s) << 24) |
+		   (payload24 & 0xffffff) | (rec.word & W_RESTART);
+}
+
+/* primary channel: safe to write at any time */
+static void store_rtc(void)
+{
+	/* no AE gate: RTCCR.AE is set at boot on some cameras (0xc5); the alarm IRQ is unused
+	 * (no RTC_CLASS) and a match needs RTCSR == RTCSAR, so a record word is harmless */
+	if (DREG(D_RTCCR) & RTCCR_AE)
+		lw.skip_ae++;	/* counts: AE was set, write done anyway */
+	rtc_write(D_RTCSAR, rec.word);
+}
+
+/* optional channel: only with IRQs off on a path that never returns */
+static void store_cp0(void)
+{
+	write_c0_epc(rec.epc);
+	write_c0_entrylo0(rec.elo0);
+	write_c0_entrylo1(rec.elo1);
+	write_c0_entryhi(((rec.up_s & 0x7ffff) << 13) |
+			 csum(rec.word, rec.epc, rec.elo0, rec.elo1));
+}
+
+static void fill_comm(u32 reason)
+{
+	struct task_struct *p = current;
+
+	rec.reason = reason;
+	rec.up_s = uptime_s();
+	make_word(pack3(p->comm));
+	rec.epc = pack4(p->comm);
+	rec.elo0 = (strlen(p->comm) > 4 ? pack3(p->comm + 4) : 0) | ELO_MARK;
+	rec.elo1 = (task_pid_nr(p) & 0x7fffff) | ELO_MARK;
+	rec.valid = 1;
+}
+
+/* called from jz_wdt_restart() right before the WDT is armed */
+void diag_lastpanic_commit(void)
+{
+	/* no exception may follow the CP0 writes (EPC); the WDT resets in 4 ms */
+	local_irq_disable();
+	if (!rec.valid)
+		fill_comm(R_RESTART);
+	rec.word |= W_RESTART;
+	store_rtc();
+	store_cp0();
+}
+
+static int diag_die(struct notifier_block *nb, unsigned long val, void *data)
+{
+	struct die_args *args = data;
+	struct pt_regs *regs = args ? args->regs : NULL;
+
+	if (val != DIE_OOPS || !regs || (rec.valid && rec.reason != R_REBOOT))
+		return NOTIFY_DONE;
+	rec.reason = in_interrupt() ? R_OOPS_IRQ : R_OOPS;
+	rec.up_s = uptime_s();
+	rec.word = 0;
+	make_word(enc_epc23(regs->cp0_epc));
+	rec.epc = regs->cp0_epc;
+	rec.elo0 = enc_addr(regs->regs[31]);
+	rec.elo1 = enc_sp(regs->regs[29]);
+	rec.valid = 1;
+	/* CP0 only from panic/restart: die() may still sleep with IRQs on */
+	store_rtc();
+	return NOTIFY_DONE;
+}
+
+static int diag_panic(struct notifier_block *nb, unsigned long ev, void *buf)
+{
+	const char *msg = buf ? buf : "";
+
+	if (!rec.valid || rec.reason == R_REBOOT || rec.reason == R_RESTART) {
+		u32 r = R_PANIC;
+
+		if (strstr(msg, "hung_task"))
+			r = R_HUNG;
+		else if (strstr(msg, "lockup") || strstr(msg, "LOCKUP"))
+			r = R_LOCKUP;
+		rec.word = 0;
+		fill_comm(r);
+		rec.epc = pack4(msg);
+		rec.elo0 = (strlen(msg) > 4 ? pack3(msg + 4) : 0) | ELO_MARK;
+		rec.elo1 = pack3(current->comm) | ELO_MARK;
+	}
+	store_rtc();
+	store_cp0();
+	return NOTIFY_DONE;
+}
+
+static int diag_reboot(struct notifier_block *nb, unsigned long ev, void *cmd)
+{
+	if (!rec.valid) {
+		fill_comm(R_REBOOT);
+		store_rtc();
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block diag_die_nb = { .notifier_call = diag_die, .priority = INT_MAX };
+static struct notifier_block diag_panic_nb = { .notifier_call = diag_panic, .priority = INT_MAX };
+static struct notifier_block diag_reboot_nb = { .notifier_call = diag_reboot, .priority = INT_MAX };
+
+/* called once from cpu_probe_ingenic(), before trap/TLB init touches CP0 */
+void diag_lastpanic_capture(unsigned int errorepc)
+{
+	if (boot.done)
+		return;
+	boot.done = 1;
+	boot.errorepc = errorepc;
+	boot.epc = read_c0_epc();
+	boot.elo0 = read_c0_entrylo0();
+	boot.elo1 = read_c0_entrylo1();
+	boot.entryhi = read_c0_entryhi();
+	boot.rtccr_early = DREG(D_RTCCR);
+	boot.wrdy_early = rtc_ready();	/* bounded wait: RTC reads may need WRDY after a reset */
+	boot.rtcsar_early = DREG(D_RTCSAR);
+	boot.rtcsar = boot.rtcsar_early;
+	boot.rtccr = DREG(D_RTCCR);
+	boot.rsr = DREG(D_RSR);
+}
+
+/* append n bytes of w (big-endian packed text) to s as printable chars */
+static void get_chars(char *s, u32 w, int n)
+{
+	int i;
+
+	char *s0 = s;
+	int any = 0;
+
+	s += strlen(s);
+	for (i = 0; i < n; i++) {
+		u8 c = (w >> (8 * (n - 1 - i))) & 0xff;
+
+		if (!c)
+			break;
+		if (c >= 0x20 && c < 0x7f && c != '"')
+			any = 1;
+		*s++ = (c >= 0x20 && c < 0x7f && c != '"') ? c : '.';
+	}
+	*s = '\0';
+	if (!any && !*s0)
+		strcpy(s0, "-");	/* no printable comm */
+}
+
+static int diag_show(struct seq_file *m, void *v)
+{
+	u32 w = boot.rtcsar, reason = w >> 28;
+	int valid = reason >= R_OOPS && reason <= R_SELFTEST;
+	int cp0_ok = valid && (boot.elo0 & ELO_MARK) && (boot.elo1 & ELO_MARK) &&
+		     csum(w, boot.epc, boot.elo0, boot.elo1) == (boot.entryhi & 0xff);
+	int is_oops = reason == R_OOPS || reason == R_OOPS_IRQ || reason == R_SELFTEST;
+
+	seq_printf(m, "raw rtcsar=0x%08x rtccr=0x%08x rsr=0x%08x errorepc=0x%08x c0_epc=0x%08x c0_entrylo0=0x%08x c0_entrylo1=0x%08x c0_entryhi=0x%08x\n",
+		   boot.rtcsar, boot.rtccr, boot.rsr, boot.errorepc,
+		   boot.epc, boot.elo0, boot.elo1, boot.entryhi);
+	seq_printf(m, "rtc early_sar=0x%08x early_cr=0x%08x early_wrdy=%u late_sar=0x%08x late_cr=0x%08x clear_rc=%d clear_rb=0x%08x\n",
+		   boot.rtcsar_early, boot.rtccr_early, boot.wrdy_early,
+		   boot.rtcsar_late, boot.rtccr_late, boot.clr_rc, boot.clr_rb);
+	seq_printf(m, "lastwrite n=%u ok=%u fail=%u skip_ae=%u stage=%u rc=%d reg=0x%08x val=0x%08x rb=0x%08x cr0=0x%08x cr1=0x%08x wenr=0x%08x now_sar=0x%08x now_cr=0x%08x\n",
+		   lw.n, lw.ok, lw.fail, lw.skip_ae, lw.stage, lw.rc, lw.reg, lw.val,
+		   lw.rb, lw.rtccr0, lw.rtccr1, lw.wenr, DREG(D_RTCSAR), DREG(D_RTCCR));
+	seq_printf(m, "errorepc %pS\n", (void *)boot.errorepc);
+	if (!valid) {
+		seq_printf(m, "record none\n");
+		return 0;
+	}
+	seq_printf(m, "record reason=%s reached_restart=%d uptime=%s cp0_ok=%d",
+		   reason_name[reason], !!(w & W_RESTART),
+		   up_name[(w >> 24) & 7], cp0_ok);
+	if (cp0_ok)
+		seq_printf(m, " uptime_s_mod=%u", boot.entryhi >> 13);
+	seq_printf(m, "\n");
+	if (is_oops) {
+		u32 epc = cp0_ok ? boot.epc : dec_epc23(w & 0xffffff);
+
+		seq_printf(m, "epc=0x%08x", epc);
+		if (cp0_ok)
+			seq_printf(m, " ra=0x%08x sp=0x%08x", dec_addr(boot.elo0), dec_sp(boot.elo1));
+		seq_printf(m, "\nepc %pS\n", (void *)epc);
+		if (cp0_ok)
+			seq_printf(m, "ra %pS\n", (void *)dec_addr(boot.elo0));
+	} else {
+		char c[8] = "", t[8] = "";
+
+		if (cp0_ok && (reason == R_REBOOT || reason == R_RESTART)) {
+			get_chars(c, boot.epc, 4);
+			get_chars(c, boot.elo0 & 0xffffff, 3);
+			seq_printf(m, "comm=\"%s\" pid=%u\n", c, boot.elo1 & 0x7fffff);
+		} else if (cp0_ok) {
+			get_chars(t, boot.epc, 4);
+			get_chars(t, boot.elo0 & 0xffffff, 3);
+			get_chars(c, boot.elo1 & 0xffffff, 3);
+			seq_printf(m, "msg=\"%s\" comm=\"%s\"\n", t, c);
+		} else {
+			get_chars(c, w & 0xffffff, 3);
+			seq_printf(m, "comm=\"%s\"\n", c);
+		}
+	}
+	return 0;
+}
+
+static int diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, diag_show, NULL);
+}
+
+static int *volatile diag_null;
+
+static ssize_t diag_write(struct file *file, const char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	char b[16] = { 0 };
+
+	if (copy_from_user(b, ubuf, min(count, sizeof(b) - 1)))
+		return -EFAULT;
+	if (!strncmp(b, "oops", 4)) {
+		pr_emerg("diag_lastpanic: test oops (NULL dereference) requested\n");
+		*diag_null = 0xd1a9;
+	} else if (!strncmp(b, "panic", 5)) {
+		panic("diag_lastpanic test panic");
+	} else if (!strncmp(b, "rtctest", 7)) {
+		u32 v = 0x7e570000 | (lw.n & 0xffff);
+		int rc = rtc_write(D_RTCSAR, v);
+
+		pr_info("diag_lastpanic: rtctest wrote 0x%08x rc=%d readback 0x%08x stage=%u cr0=0x%08x cr1=0x%08x wenr=0x%08x\n",
+			v, rc, DREG(D_RTCSAR), lw.stage, lw.rtccr0, lw.rtccr1, lw.wenr);
+	} else if (!strncmp(b, "selftest", 8)) {
+		rec.reason = R_SELFTEST;
+		rec.up_s = uptime_s();
+		rec.word = 0;
+		make_word(enc_epc23(0x8012345c));
+		rec.epc = 0xd1a9e9c0;
+		rec.elo0 = enc_addr(0x8012345c);
+		rec.elo1 = enc_sp(0x8123abc8);
+		rec.valid = 1;
+		store_rtc();	/* CP0 follows in jz_wdt_restart() */
+		pr_info("diag_lastpanic: selftest word 0x%08x, rtcsar readback 0x%08x stage=%u rc=%d cr0=0x%08x cr1=0x%08x wenr=0x%08x skip_ae=%u; now reboot -f\n",
+			rec.word, DREG(D_RTCSAR), lw.stage, lw.rc, lw.rtccr0, lw.rtccr1, lw.wenr, lw.skip_ae);
+	} else {
+		return -EINVAL;
+	}
+	return count;
+}
+
+static const struct file_operations diag_fops = {
+	.open = diag_open,
+	.read = seq_read,
+	.write = diag_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int __init diag_lastpanic_init(void)
+{
+	/* consume the previous record so a later reset without one reads 0 */
+	boot.rtccr_late = DREG(D_RTCCR);
+	boot.rtcsar_late = DREG(D_RTCSAR);
+	if (boot.rtcsar_late != boot.rtcsar_early)
+		boot.rtcsar = boot.rtcsar_late;	/* early read was not valid: decode the late one */
+	if (boot.rtcsar_late) {
+		boot.clr_rc = rtc_write(D_RTCSAR, 0);
+		boot.clr_rb = DREG(D_RTCSAR);
+	}
+	register_die_notifier(&diag_die_nb);
+	atomic_notifier_chain_register(&panic_notifier_list, &diag_panic_nb);
+	register_reboot_notifier(&diag_reboot_nb);
+	proc_create("diag_lastpanic", 0600, NULL, &diag_fops);
+	pr_info("diag_lastpanic: early_sar=0x%08x late_sar=0x%08x clear_rc=%d clear_rb=0x%08x stage=%u cr0=0x%08x cr1=0x%08x wenr=0x%08x\n",
+		boot.rtcsar_early, boot.rtcsar_late, boot.clr_rc, boot.clr_rb, lw.stage, lw.rtccr0, lw.rtccr1, lw.wenr);
+	pr_info("diag_lastpanic: prev rtcsar=0x%08x rtccr=0x%08x c0_epc=0x%08x entrylo0=0x%08x entrylo1=0x%08x entryhi=0x%08x\n",
+		boot.rtcsar, boot.rtccr, boot.epc, boot.elo0, boot.elo1, boot.entryhi);
+	return 0;
+}
+core_initcall(diag_lastpanic_init);
