+/* kernel/hung_task.c, right before its panic(): remember the blocked task */
+void diag_lastpanic_hung(struct task_struct *t)
+{
+	strlcpy(hung_comm, t->comm, sizeof(hung_comm));
+}
+
+#ifdef CONFIG_JZ_DIAG_EPC_SLED
+#define SL_KOOPS	0x0000000
+#define SL_KLOCK	0x0400000
+#define SL_MOOPS	0x0800000
+#define SL_MLOCK	0x1000000
+#define SL_OTHER	0x1800000
+#define SL_END		0x1c00000	/* low ramoops window starts here */
+#define SL_INSN_B	0x1000ffff	/* b . (beq $0,$0,-1) */
+
+static u32 sled_phys(void)
+{
+	u32 a = rec.loc, q, up, c0, c1;
+
+	if (rec.valid && a >= 0x80000000 && a < 0x80400000)
+		return (rec.lkind ? SL_KLOCK : SL_KOOPS) + (a & 0x3ffffc);
+	if (rec.valid && a >= 0xc0000000 && a < 0xc0800000)
+		return (rec.lkind ? SL_MLOCK : SL_MOOPS) + (a & 0x7ffffc);
+	up = rec.up_s < 600 ? 0 : rec.up_s < 3600 ? 1 : rec.up_s < 86400 ? 2 : 3;
+	c0 = rec.cm[0] & 0x7f;
+	c1 = rec.cm[1] & 0x7f;
+	q = ((rec.reason & 0xf) << 16) | (up << 14) | (c0 << 7) | c1;
+	return SL_OTHER + (q << 2);
+}
+
+/* never returns: the CPU spins at kseg1 | phys until the armed WDT resets it */
+static noinline void sled_jump(u32 phys)
+{
+	u32 k1 = 0xa0000000 | phys;
+
+	/* no dirty kseg0 line may be written back over the loop */
+	dma_cache_wback_inv(0x80000000 | phys, 8);
+	__asm__ __volatile__(
+		".set push\n\t.set noreorder\n\t"
+		"sw	%1, 0(%0)\n\t"
+		"sw	$0, 4(%0)\n\t"
+		"sync\n\t"
+		"lw	$0, 4(%0)\n\t"	/* uncached read-back drains the write buffer */
+		"jr	%0\n\t"
+		"nop\n\t"
+		".set pop"
+		: : "r"(k1), "r"(SL_INSN_B) : "memory");
+	for (;;)
+		;
+}
+
+/* called from jz_wdt_restart() after wdt_start_count(); IRQs are off */
+void diag_lastpanic_sled(void)
+{
+	u32 phys = sled_phys();
+	u32 self = (u32)sled_jump & 0x1fffffff;
+
+	local_irq_disable();
+	if (phys >= SL_END || phys + 8 > PFN_PHYS(max_low_pfn))
+		return;		/* not inside Linux RAM: keep the stock mdelay path */
+	if (phys + 8 > self - 64 && phys < self + 256)
+		return;		/* would overwrite the jump code itself */
+	sled_jump(phys);
+}
+
+static const char *sled_class(u32 p)
+{
+	if (p < SL_KLOCK) return "kernel_oops";
+	if (p < SL_MOOPS) return "kernel_lockup";
+	if (p < SL_MLOCK) return "module_oops";
+	if (p < SL_OTHER) return "module_lockup";
+	return "other";
+}
+
+static void sled_show(struct seq_file *m, u32 errorepc)
+{
+	static const char *const upq[4] = { "<10m", "10m-1h", "1h-24h", ">=24h" };
+	u32 p = errorepc & 0x1fffffff, a, q;
+	char c[3];
+
+	if ((errorepc & 0xe0000000) != 0xa0000000 || p >= SL_END || (p & 3)) {
+		seq_printf(m, "sled none (errorepc not a sled address: stock restart, WDT bite or power-on)\n");
+		return;
+	}
+	if (p < SL_OTHER) {
+		if (p < SL_MOOPS)
+			a = 0x80000000 | (p & 0x3fffff);
+		else
+			a = 0xc0000000 | ((p - (p < SL_MLOCK ? SL_MOOPS : SL_MLOCK)) & 0x7fffff);
+		seq_printf(m, "sled class=%s loc=0x%08x\nsled loc %pS\n", sled_class(p), a, (void *)a);
+		return;
+	}
+	q = (p - SL_OTHER) >> 2;
+	c[0] = (q >> 7) & 0x7f;
+	c[1] = q & 0x7f;
+	c[2] = 0;
+	if (c[0] && (c[0] < 0x20 || c[0] == '"' || c[0] == 0x7f)) c[0] = '.';
+	if (c[1] && (c[1] < 0x20 || c[1] == '"' || c[1] == 0x7f)) c[1] = '.';
+	seq_printf(m, "sled class=other reason=%s uptime=%s comm2=\"%s\"\n",
+		   reason_name[(q >> 16) & 0xf] ? reason_name[(q >> 16) & 0xf] : "?",
+		   upq[(q >> 14) & 3], c);
+}
+#endif
