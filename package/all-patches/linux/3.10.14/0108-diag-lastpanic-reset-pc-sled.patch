+config JZ_DIAG_EPC_SLED
+	depends on JZ_DIAG_LASTPANIC
+	bool "encode the last-panic record in the reset PC (CP0 ErrorEPC)"
+	default y
+	help
+	  In jz_wdt_restart(), after the WDT is armed, the CPU spins in a
+	  two-instruction loop written to an uncached (kseg1) RAM address
+	  that encodes the record (oops/lockup epc, or reason + comm). The
+	  WDT reset stores that PC in ErrorEPC, which the next boot reads
+	  (the existing "CPU0 RESET ERROR PC" value). For SoCs without a
+	  reset-surviving register (T23). Diagnostics builds only.
+
 config TRAPS_USE_TCSM_CHECK
 	depends on TRAPS_USE_TCSM
 	bool "check tcsm when power resume"
