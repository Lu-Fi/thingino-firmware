From 55f795f9b2294955977306b6d7f61307e3ab7dd2 Mon Sep 17 00:00:00 2001
From: Lu-Fi <lutz@fiebach.de>
Date: Thu, 10 Sep 2026 13:40:52 +0200
Subject: [PATCH] sensor: t23 sc2336p, fix shvflip register bugs and apply at
 init

sensor_set_vflip() had two bugs: the register read clobbered the read
value with sensor_read's own return code, and case 3 (combined H+V)
used &= instead of |=, so it always wrote 0x00 regardless of intent.
Fixed both (matching the correct t40 copy of this driver).

Also call sensor_set_vflip(sd, 3) from sensor_init() when shvflip=1
(module param, e.g. BR2_SENSOR_1_PARAMS), so a sensor mounted 180deg
rotated relative to its housing self-corrects at the register level
for every IMP client, independent of which ISP tuning API (if any)
a given streamer calls. Verified safe on a real C500 unit (T23,
sc2336p) via a flat-field A/B test: no measurable LSC/shading
mismatch (<0.3%) and no Bayer-phase break between this and the
existing ISP-side flip.

Changed the module's own default from 1 to 0 (matching every other
sensor driver in this SDK, e.g. sc500ai.c, imx307.c): with shvflip
now doing something real at init, any board that never explicitly
set this param would have silently started flipping. Boards that
already set shvflip=1 in BR2_SENSOR_1_PARAMS are unaffected.
---
 3.10.14/sensor-src/t23/sc2336p.c | 26 +++++++++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/3.10.14/sensor-src/t23/sc2336p.c b/3.10.14/sensor-src/t23/sc2336p.c
index ee9f15e6..1866c1aa 100644
--- a/3.10.14/sensor-src/t23/sc2336p.c
+++ b/3.10.14/sensor-src/t23/sc2336p.c
@@ -70,7 +70,7 @@ static int data_interface = TX_SENSOR_DATA_INTERFACE_MIPI;
 module_param(data_interface, int, S_IRUGO);
 MODULE_PARM_DESC(data_interface, "Sensor Date interface");
 
-static int shvflip = 1;
+static int shvflip = 0;
 module_param(shvflip, int, S_IRUGO);
 MODULE_PARM_DESC(shvflip, "Sensor HV Flip Enable interface");
 
@@ -1118,6 +1118,8 @@ static int sensor_get_black_pedestal(struct tx_isp_subdev *sd, int value)
 	return 0;
 }
 
+static int sensor_set_vflip(struct tx_isp_subdev *sd, int enable);
+
 static int sensor_init(struct tx_isp_subdev *sd, int enable)
 {
 	struct tx_isp_sensor *sensor = sd_to_sensor_device(sd);
@@ -1139,6 +1141,22 @@ static int sensor_init(struct tx_isp_subdev *sd, int enable)
 	if (ret)
 		return ret;
 
+	/* Board-level mount compensation: shvflip=1 (module param, e.g. from
+	 * BR2_SENSOR_1_PARAMS) means this sensor is physically mounted
+	 * rotated 180 deg relative to its housing. Apply the full H+V flip
+	 * directly here so every IMP client gets an already-corrected image
+	 * from the first frame, independent of which ISP tuning API (if
+	 * any) a given streamer calls. Must run after the mode table above
+	 * (register 0x0103 in that table resets the sensor and would wipe
+	 * this) and is safe to fail softly - a write error here shouldn't
+	 * block streaming, just leave the image un-mirrored.
+	 */
+	if (shvflip) {
+		ret = sensor_set_vflip(sd, 3);
+		if (ret)
+			ISP_ERROR("%s: failed to apply shvflip (%d)\n", __func__, ret);
+	}
+
 	ret = tx_isp_call_subdev_notify(sd, TX_ISP_EVENT_SYNC_SENSOR_ATTR, &sensor->video);
 	sensor->priv = wsize;
 
@@ -1259,7 +1277,9 @@ static int sensor_set_vflip(struct tx_isp_subdev *sd, int enable)
 	int ret = 0;
 	uint8_t val;
 
-	val = sensor_read(sd, 0x3221, &val);
+	ret = sensor_read(sd, 0x3221, &val);
+	if (ret < 0)
+		return ret;
 	switch(enable) {
 	case 0:
 		val &= 0x99;
@@ -1271,7 +1291,7 @@ static int sensor_set_vflip(struct tx_isp_subdev *sd, int enable)
 		val = ((val & 0xF9) | 0x60);
 		break;
 	case 3:
-		val &= 0x66;
+		val |= 0x66;
 		break;
 	}
 	ret += sensor_write(sd, 0x3221, val);
-- 
2.53.0

