--- a/common/misc/motor/motor.c	2026-10-17 13:18:31.946966517 +0200
+++ b/common/misc/motor/motor.c	2026-10-17 13:18:31.951346036 +0200
@@ -44,6 +44,46 @@
 #include <soc/gpio.h>
 #include "motor.h"
 
+/* Runtime configuration (thingino: pins come from thingino.json via modprobe) */
+static int hst1 = -1, hst2 = -1, hst3 = -1, hst4 = -1;
+static int vst1 = -1, vst2 = -1, vst3 = -1, vst4 = -1;
+static int hmin = -1, hmax = -1, vmin = -1, vmax = -1;
+static int hmaxstep = 0, vmaxstep = 0;
+static int invert_gpio_dir = 0;
+static int motor_switch_gpio = -1;
+static char *tcu_channels;
+static bool nolimits;
+static bool debug;
+module_param(hst1, int, S_IRUGO); module_param(hst2, int, S_IRUGO);
+module_param(hst3, int, S_IRUGO); module_param(hst4, int, S_IRUGO);
+module_param(vst1, int, S_IRUGO); module_param(vst2, int, S_IRUGO);
+module_param(vst3, int, S_IRUGO); module_param(vst4, int, S_IRUGO);
+module_param(hmin, int, S_IRUGO); module_param(hmax, int, S_IRUGO);
+module_param(vmin, int, S_IRUGO); module_param(vmax, int, S_IRUGO);
+module_param(hmaxstep, int, S_IRUGO); module_param(vmaxstep, int, S_IRUGO);
+module_param(invert_gpio_dir, int, S_IRUGO);
+module_param(motor_switch_gpio, int, S_IRUGO);
+module_param(tcu_channels, charp, S_IRUGO);
+module_param(nolimits, bool, 0644);
+module_param(debug, bool, 0644);
+MODULE_PARM_DESC(hst1, "Pan phase A..D pins hst1..hst4, vst1..vst4 tilt (-1 unused)");
+MODULE_PARM_DESC(hmaxstep, "Pan max steps (used when no end switches)");
+MODULE_PARM_DESC(nolimits, "No end switches: trust hmaxstep/vmaxstep");
+
+/* read an end switch; unconfigured pin reads as "not pressed" */
+static int mgv(unsigned int gpio, int level)
+{
+	if (gpio == (unsigned int)-1)
+		return !level;
+	return gpio_get_value(gpio);
+}
+static void mgo(unsigned int gpio, int v)
+{
+	if (gpio == (unsigned int)-1)
+		return;
+	gpio_direction_output(gpio, invert_gpio_dir ? !v : !!v);
+}
+
