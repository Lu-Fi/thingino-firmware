config BR2_PACKAGE_OPENIMP_SUPPORTED
	bool
	default y if BR2_SOC_FAMILY = "t20" && KERNEL_VERSION_3
	default y if BR2_SOC_FAMILY = "t21" && KERNEL_VERSION_3
	default y if BR2_SOC_FAMILY = "t23" && KERNEL_VERSION_3
	default y if BR2_SOC_FAMILY = "t30" && KERNEL_VERSION_3
	default y if BR2_SOC_FAMILY = "t31" && BR2_INGENIC_SOC_MODEL != "c100" && KERNEL_VERSION_3
	default y if BR2_SOC_FAMILY = "t40" && KERNEL_VERSION_4
	default y if BR2_SOC_FAMILY = "t41" && KERNEL_VERSION_4

config BR2_PACKAGE_OPENIMP
	bool
	depends on BR2_PACKAGE_OPENIMP_SUPPORTED
	depends on BR2_PACKAGE_THINGINO_ISP_OPEN
	depends on BR2_THINGINO_DEV_CAMERA
	help
	  OpenIMP is an open-source implementation of the Ingenic IMP
	  (Image Media Process) library. It provides a
	  reverse-engineered implementation of libimp.so that can
	  replace the proprietary Ingenic library.

	  Current upstream builds support T20, T21, T23, T30, T31, T40,
	  and T41. This package installs the matching build/<soc>/libimp.so
	  in staging and on the target, then preserves that replacement
	  during target finalization.

	  T23 uses OpenIMP's native Helix encoder; the OEM Helix worker
	  is optional (BR2_PACKAGE_OPENIMP_T23_OEM_HELPER). T30 is video-only:
	  its build deliberately refuses to export the IMP audio entry points.
	  T20/T21 reuse the T31 audio implementation; T31/T40/T41 include
	  audio. Some optional OSD/IVS entry points remain incomplete.

	  https://github.com/opensensor/openimp

config BR2_PACKAGE_OPENIMP_T23_OEM_HELPER
	bool "Install the T23 OEM Helix helper (vendor libimp + openimp-t23-helixd)"
	default n
	depends on BR2_PACKAGE_OPENIMP
	depends on BR2_SOC_FAMILY = "t23"
	select BR2_PACKAGE_INGENIC_LIB_LIBIMP
	help
	  Build openimp-t23-helixd and ship it with the vendor libimp.so under
	  /opt/openimp-t23/, so OPENIMP_T23_ENCODER=worker works.
	  Off by default: OpenIMP T23 uses its native Helix encoder for bound
	  channels and YuvInit, and no vendor code is built or shipped. Needed
	  only for the worker fallback and the hardware JPEG IMP_Decoder.
