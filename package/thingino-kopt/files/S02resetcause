#!/bin/sh
# Reset diagnostics (BR2_THINGINO_DIAG): log why the last boot happened.
#  /proc/diag_lastpanic (kernel JZ_DIAG_LASTPANIC): record of the previous kernel death/restart,
#  kept in RTC RTCSAR (survives the WDT reset, measured on T31L) + optional CP0 copy (unproven, cp0_ok=1
#  when its checksum matches; then also ra/sp/full text).
#  Summary line in syslog (tag resetcause):
#   PANIC reason=oops epc=0x... <func+off/size> [ra=0x... <func+off/size> sp=0x...] up=<bucket>
#   PANIC reason=hung_task|lockup|panic comm="..." [msg="..."] up=<bucket>
#   RESTART reason=reboot|restart comm="..." up=<bucket>   (clean kernel restart, no panic)
#   NORECORD rsr=0x...   (no kernel restart before the reset: WDT bite / power loss / hard hang)
#  rsr = CPM RSR 0x10000008: bit0 power-on, bit1 WDT, bit3 hibernate (T21 PM; same CPM on T23/T31).
# The same lines are logged again after 120 s (remote syslog is reachable then, module symbols loaded).
P=/proc/diag_lastpanic
D=/tmp/diag-lastreset

rsr_txt() {
	r=$(($1))
	t=""
	[ $((r & 1)) -ne 0 ] && t="$t poweron"
	[ $((r & 2)) -ne 0 ] && t="$t wdt"
	[ $((r & 8)) -ne 0 ] && t="$t hibernate"
	echo "${t# }"
}

summary() {
	f=$1
	raw=$(grep '^raw ' "$f")
	rsr=$(echo "$raw" | sed -n 's/.* rsr=\(0x[0-9a-f]*\).*/\1/p')
	rec=$(grep '^record ' "$f")
	if [ -z "$rec" ] || [ "$rec" = "record none" ]; then
		echo "NORECORD rsr=$rsr ($(rsr_txt ${rsr:-0})) $(grep '^errorepc ' "$f")"
		return
	fi
	reason=$(echo "$rec" | sed -n 's/.* reason=\([a-z_]*\).*/\1/p')
	up=$(echo "$rec" | sed -n 's/.* uptime=\([^ ]*\).*/\1/p')
	ok=$(echo "$rec" | sed -n 's/.*\(reached_restart=[01]\).*\(cp0_ok=[01]\).*/\1 \2/p')
	case "$reason" in
	reboot|restart) kind=RESTART ;;
	selftest) kind=SELFTEST ;;
	*) kind=PANIC ;;
	esac
	if grep -q '^epc=' "$f"; then
		regs=$(grep '^epc=' "$f")
		esym=$(sed -n 's/^epc \(.*\)/\1/p' "$f")
		rsym=$(sed -n 's/^ra \(.*\)/\1/p' "$f")
		set -- $regs
		if [ -n "$2" ]; then
			echo "$kind reason=$reason $1 <$esym> $2 <$rsym> $3 up=$up rsr=$rsr $ok"
		else
			echo "$kind reason=$reason $1 <$esym> up=$up rsr=$rsr $ok"
		fi
	else
		echo "$kind reason=$reason $(grep -E '^(msg|comm)=' "$f") up=$up rsr=$rsr $ok"
	fi
}

report() {
	tag=$1
	if [ -r $P ]; then
		f=$D/lastpanic; [ -n "$tag" ] && f=$D/lastpanic-late
		cat $P > $f 2>/dev/null
		while IFS= read -r l; do logger -t resetcause "$tag$l"; done < $f
		logger -p user.crit -t resetcause "$tag$(summary $f)"
	else
		RSR=$(devmem 0x10000008 32 2>/dev/null)
		logger -t resetcause "${tag}no $P (kernel without JZ_DIAG_LASTPANIC) rsr=$RSR ($(rsr_txt ${RSR:-0}))"
	fi
}

case "$1" in
start)
	mkdir -p $D
	logger -t resetcause "boot up=$(cut -d' ' -f1 /proc/uptime)"
	report ""
	# keep the record over the next reboot (only when there is one; rare flash write)
	if [ -w /opt ] && grep -q '^record reason' $D/lastpanic 2>/dev/null; then
		mkdir -p /opt/diag-lastreset && cp $D/lastpanic /opt/diag-lastreset/lastpanic-$(date +%Y%m%d%H%M%S 2>/dev/null) 2>/dev/null
		ls -1t /opt/diag-lastreset/lastpanic-* 2>/dev/null | tail -n +6 | xargs -r rm -f
	fi
	# diag1 compatibility: pstore files, if a ramoops kernel left any
	if [ -d /sys/fs/pstore ] && ls /sys/fs/pstore/* >/dev/null 2>&1; then
		for f in /sys/fs/pstore/*; do
			cp "$f" $D/ 2>/dev/null && logger -t resetcause "pstore $(basename "$f") $(wc -c < "$f") bytes"
		done
	fi
	( sleep 120; report "late " ) </dev/null >/dev/null 2>&1 &
	;;
stop|restart|reload) ;;
*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
